...@../shared/classes

vars: {
  d2-config: {
    layout-engine: dagre
    # pad: 24
    # center: true
  }
}

direction: down

robot: {
  label: "Robot"
  class: boundary

  runtime: {
    label: "Robot runtime"
    class: robot_runtime
    tooltip: "Onboard perception, autonomy, recording, and ROS 2 integration."
    link: "../../../architecture/overview/"
  }

  firmware: {
    label: "Firmware"
    class: firmware
    tooltip: "Teensy-owned low-level control and sensor integration."
    link: "../../../architecture/overview/"
  }

  hardware: {
    label: "Physical hardware"
    class: hardware
    tooltip: "Robot compute, sensors, actuators, power, and electrical systems."
    link: "../../../hardware/circuit/"
  }

  run_bundle_output: {
    label: "Local RunBundle storage"
    class: evidence
    tooltip: "Structured evidence recorded locally during a robot run."
    link: "../../../verification/evidence/"
  }
}

workstation: {
  label: "Workstation"
  class: boundary

  laptop: {
    label: "Operator application"
    class: laptop
    tooltip: "Off-robot tools for control, diagnostics, evidence retrieval, and review."
    link: "../../../operations/operator-run-workflow/"
  }

  run_bundle_archive: {
    label: "RunBundle archive"
    class: evidence
    tooltip: "RunBundles retrieved from the robot and retained for analysis."
    link: "../../../verification/evidence/"
  }

  report: {
    label: "Static report"
    class: evidence
    shape: document
    tooltip: "Human-readable report generated from an archived RunBundle."
    link: "../../../verification/evidence/"
  }
}

# Operational path

workstation.laptop <-> robot.runtime: "commands / telemetry" {
  class: command_edge
}

robot.runtime <-> robot.firmware: "control / feedback" {
  class: command_edge
}

robot.firmware <-> robot.hardware: "actuation / sensing" {
  class: command_edge
}

# Evidence path

robot.runtime -> robot.run_bundle_output: "record" {
  class: evidence_edge
}

workstation.laptop -> workstation.run_bundle_archive: "sync" {
  class: evidence_edge
  style.stroke-dash: 3
}

# workstation.laptop -> workstation.run_bundle_archive: "transfer" {
#   class: evidence_edge
#   style.stroke-dash: 3
# }
workstation.run_bundle_archive -> workstation.report: "generate" {
  class: evidence_edge
  style.stroke-dash: 3
}
